# Supabase Postgres connection string (Session pooler recommended for serverless/Lambda)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# App
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
AUTH_METHODS=email_password

# Seat lock TTL (minutes) — Postgres-based lock, see readme/flows/booking.md
SEAT_LOCK_TTL_MINUTES=10

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
